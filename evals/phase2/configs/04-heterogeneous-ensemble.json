{
  "models": [
    {"name": "gemma-small", "backend": "ollama", "model": "gemma4:e4b", "base_url": "http://127.0.0.1:11434", "timeout_seconds": 600},
    {"name": "gptoss", "backend": "ollama", "model": "gpt-oss:20b", "base_url": "http://127.0.0.1:11434", "timeout_seconds": 600},
    {"name": "qwen", "backend": "ollama", "model": "qwen2.5:0.5b", "base_url": "http://127.0.0.1:11434", "timeout_seconds": 600},
    {"name": "synth", "backend": "ollama", "model": "gemma4:26b", "base_url": "http://127.0.0.1:11434", "timeout_seconds": 600}
  ],
  "roles": [
    {"name": "gemma-view", "model": "gemma-small", "always_include": true},
    {"name": "gptoss-view", "model": "gptoss", "always_include": true},
    {"name": "qwen-view", "model": "qwen", "always_include": true},
    {"name": "synthesizer", "model": "synth", "is_synthesizer": true}
  ],
  "coordinator": {
    "enabled": true,
    "default_pattern": "role_split",
    "rules": [{"match": ["EVAL:"], "pattern": "role_split"}]
  },
  "orchestrator": {"selection_policy": "all", "max_parallel_workers": 3, "temperature": 0.2}
}
